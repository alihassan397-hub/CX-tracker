rules_version = '2';

// CX Tracker — Firestore Security Rules
//
// These rules are the REAL enforcement of "only a Unit Head can assign
// tasks / edit members / delete things, and team members can only touch
// their own work". The Android app also checks roles before showing
// buttons, but that only controls what the app SHOWS — it does nothing to
// stop a modified copy of the app from sending the same request straight
// to the server. These rules are what actually block it.
//
// Deploy with: firebase deploy --only firestore:rules
// (or paste this file's contents directly into Firebase Console →
// Firestore Database → Rules → Publish)

function isSignedIn() {
  return request.auth != null;
}

// Each user's Firestore profile document ID IS their Firebase Auth UID
// (see CxRepository.insertUserAccount), so this is a single, direct,
// cheap lookup — no separate mirror collection or Cloud Function needed
// for this check to work.
function getUserDoc() {
  return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
}

function isUnitHead() {
  return isSignedIn() && getUserDoc().role in ["UNIT_HEAD", "ADMIN"];
}

function isOwner(userId) {
  return isSignedIn() && getUserDoc().id == userId;
}

// True if the caller's own account email matches the given team-roster
// member's email — i.e. the task's assignee IS the person making the
// request, not some other team member.
function isAssignedMember(assigneeId) {
  return isSignedIn() &&
    get(/databases/$(database)/documents/teamMembers/$(string(assigneeId))).data.email == getUserDoc().email;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- users : profile data (document ID = Firebase Auth UID) ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && request.resource.data.role == "TEAM_MEMBER"
                    && request.resource.data.authUid == request.auth.uid;
      allow update: if isUnitHead()
                    || (isSignedIn()
                        && uid == request.auth.uid
                        && request.resource.data.role == resource.data.role);
      allow delete: if isUnitHead();
    }

    // ---- units & team roster ----
    match /units/{docId} {
      allow read: if isSignedIn();
      allow write: if isUnitHead();
    }

    match /teamMembers/{docId} {
      allow read: if isSignedIn();
      allow create: if isUnitHead() ||
        (isSignedIn() && request.resource.data.email == getUserDoc().email);
      allow update, delete: if isUnitHead();
    }

    // ---- tasks assigned by the Unit Head ----
    match /tasks/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isUnitHead();
      // A Unit Head can edit anything. The team member the task is actually
      // assigned to may update its status/remarks — never reassign it,
      // change its deadline, or touch a task assigned to someone else.
      allow update: if isUnitHead() ||
        (isSignedIn() &&
         request.resource.data.unitId == resource.data.unitId &&
         request.resource.data.assigneeId == resource.data.assigneeId &&
         request.resource.data.dueDateTime == resource.data.dueDateTime &&
         request.resource.data.tatHours == resource.data.tatHours &&
         isAssignedMember(resource.data.assigneeId));
    }

    // ---- time-motion logs ----
    match /timeMotionLogs/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isUnitHead();
    }

    // ---- each team member's own daily task entries ----
    match /dailyTasks/{docId} {
      allow read: if isSignedIn();
      // A member can only create an entry under their OWN account id — not
      // log hours/tasks on someone else's behalf.
      allow create: if isSignedIn() && request.resource.data.userId == getUserDoc().id;
      allow update, delete: if isUnitHead() || isOwner(resource.data.userId);
    }
  }
}
